---
import BaseLayout from '../layouts/BaseLayout.astro';
import { US_STATES, STATE_NAME_BY_CODE } from '../data/states';
import { INSTALLERS, LENDERS } from '../data/installers';

const installersJson = JSON.stringify(INSTALLERS);
const lendersJson = JSON.stringify(LENDERS);
const stateNamesJson = JSON.stringify(STATE_NAME_BY_CODE);
const installerStates = US_STATES
  .filter((state) => INSTALLERS.some((installer) => installer.states.includes(state.code)))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title="Installers - SolarHelp" description="Find solar installers available by state and filter installer and lender options by coverage.">
  <main class="page-shell installers-page">
    <section class="installers-hero" aria-labelledby="installers-title">
      <div>
        <span class="eyebrow">SOLAR COVERAGE DIRECTORY</span>
        <h1 id="installers-title">Installers</h1>
        <p>Select a state to see every installer currently listed for that market. Installer and lender dropdowns update automatically for the selected state.</p>
      </div>
      <div class="installers-summary" aria-label="Installer coverage summary">
        <div><strong>{INSTALLERS.length}</strong><span>installers</span></div>
        <div><strong>{installerStates.length}</strong><span>states & territories</span></div>
      </div>
    </section>

    <section class="panel installers-directory" aria-label="Installer directory filters">
      <div class="installer-filter-grid">
        <label class="field premium-select" for="installer-state-select">
          <span>State / territory</span>
          <select id="installer-state-select" aria-describedby="installer-directory-status">
            <option value="" selected>Select a state / territory</option>
            {installerStates.map((state) => <option value={state.code}>{state.name} ({state.code})</option>)}
          </select>
        </label>

        <label class="field premium-select" for="installer-select">
          <span>Installer</span>
          <select id="installer-select" disabled>
            <option value="" selected>Select a state first</option>
          </select>
        </label>

        <label class="field premium-select" for="lender-select">
          <span>Lender</span>
          <select id="lender-select" disabled>
            <option value="" selected>Lender data not added yet</option>
          </select>
        </label>
      </div>

      <div id="installer-directory-status" class="installer-status" aria-live="polite">
        <span class="status-dot" aria-hidden="true"></span>
        <strong>Select a state / territory</strong>
        <span>Available installers will appear below.</span>
      </div>

      <div id="installer-results" class="installer-results" hidden></div>
    </section>
  </main>

  <script id="installer-data" type="application/json" is:inline set:html={installersJson}></script>
  <script id="lender-data" type="application/json" is:inline set:html={lendersJson}></script>
  <script id="installer-state-names" type="application/json" is:inline set:html={stateNamesJson}></script>

  <script>
    const stateSelect = document.getElementById('installer-state-select');
    const installerSelect = document.getElementById('installer-select');
    const lenderSelect = document.getElementById('lender-select');
    const status = document.getElementById('installer-directory-status');
    const results = document.getElementById('installer-results');
    const installers = JSON.parse(document.getElementById('installer-data')?.textContent || '[]');
    const lenders = JSON.parse(document.getElementById('lender-data')?.textContent || '[]');
    const stateNames = JSON.parse(document.getElementById('installer-state-names')?.textContent || '{}');

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));

    function installerNote(installer, stateCode) {
      return installer?.stateNotes?.[stateCode] || '';
    }

    function setInstallerOptions(stateCode) {
      if (!installerSelect) return [];
      const available = installers.filter((installer) => installer.states.includes(stateCode));
      installerSelect.innerHTML = '';

      const allOption = document.createElement('option');
      allOption.value = '';
      allOption.textContent = available.length ? `All installers (${available.length})` : 'No installers listed';
      installerSelect.appendChild(allOption);

      available.forEach((installer) => {
        const option = document.createElement('option');
        option.value = installer.name;
        const note = installerNote(installer, stateCode);
        option.textContent = note ? `${installer.name} — ${note}` : installer.name;
        installerSelect.appendChild(option);
      });

      installerSelect.disabled = available.length === 0;
      return available;
    }

    function setLenderOptions(stateCode) {
      if (!lenderSelect) return [];
      const available = lenders.filter((lender) => Array.isArray(lender.states) && lender.states.includes(stateCode));
      lenderSelect.innerHTML = '';

      if (!available.length) {
        const option = document.createElement('option');
        option.value = '';
        option.textContent = 'Lender data not added yet';
        lenderSelect.appendChild(option);
        lenderSelect.disabled = true;
        return available;
      }

      const allOption = document.createElement('option');
      allOption.value = '';
      allOption.textContent = `All lenders (${available.length})`;
      lenderSelect.appendChild(allOption);

      available.forEach((lender) => {
        const option = document.createElement('option');
        option.value = lender.name;
        option.textContent = lender.name;
        lenderSelect.appendChild(option);
      });

      lenderSelect.disabled = false;
      return available;
    }

    function render() {
      if (!stateSelect || !installerSelect || !lenderSelect || !status || !results) return;
      const stateCode = stateSelect.value;

      if (!stateCode) {
        installerSelect.innerHTML = '<option value="">Select a state first</option>';
        installerSelect.disabled = true;
        lenderSelect.innerHTML = '<option value="">Lender data not added yet</option>';
        lenderSelect.disabled = true;
        status.innerHTML = '<span class="status-dot" aria-hidden="true"></span><strong>Select a state / territory</strong><span>Available installers will appear below.</span>';
        results.innerHTML = '';
        results.hidden = true;
        return;
      }

      const stateName = stateNames[stateCode] || stateCode;
      const stateInstallers = installers.filter((installer) => installer.states.includes(stateCode));
      const selectedInstaller = installerSelect.value;
      const visibleInstallers = selectedInstaller
        ? stateInstallers.filter((installer) => installer.name === selectedInstaller)
        : stateInstallers;

      status.innerHTML = `<span class="status-dot" aria-hidden="true"></span><strong>${escapeHtml(stateName)} (${escapeHtml(stateCode)})</strong><span>${stateInstallers.length} installer${stateInstallers.length === 1 ? '' : 's'} available</span>`;
      results.hidden = false;

      if (!visibleInstallers.length) {
        results.innerHTML = '<div class="installer-empty">No installers are listed for this selection.</div>';
        return;
      }

      results.innerHTML = visibleInstallers.map((installer) => {
        const note = installerNote(installer, stateCode);
        const isOnHold = note.toUpperCase() === 'ON HOLD';
        return `
          <article class="installer-card${isOnHold ? ' is-on-hold' : ''}">
            <div class="installer-card-top">
              <span class="installer-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18h16M6 18V9l6-4 6 4v9"></path><path d="M9 18v-5h6v5M9 9h6"></path></svg>
              </span>
              <div>
                <h2>${escapeHtml(installer.name)}</h2>
                <p>${escapeHtml(stateName)} (${escapeHtml(stateCode)})</p>
              </div>
              <span class="installer-availability${isOnHold ? ' hold' : ''}">${isOnHold ? 'ON HOLD' : 'AVAILABLE'}</span>
            </div>
            ${note && !isOnHold ? `<div class="installer-note">${escapeHtml(note)}</div>` : ''}
          </article>
        `;
      }).join('');
    }

    stateSelect?.addEventListener('change', () => {
      const stateCode = stateSelect.value;
      if (!stateCode) {
        render();
        return;
      }
      setInstallerOptions(stateCode);
      setLenderOptions(stateCode);
      render();
    });

    installerSelect?.addEventListener('change', render);
    lenderSelect?.addEventListener('change', render);
    render();
  </script>

  <style>
    .installers-page{max-width:1180px}
    .installers-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:30px;margin-bottom:22px;padding:30px 32px;border-radius:16px;background:#111418;color:#fff;box-shadow:0 18px 44px rgba(17,20,24,.12)}
    .installers-hero h1{margin:7px 0 8px;color:#fff;font-size:clamp(30px,4vw,46px);letter-spacing:-.035em}
    .installers-hero p{max-width:760px;margin:0;color:#d5d9dc;font-size:15px;line-height:1.65}
    .installers-hero .eyebrow{color:#b9c0c5;font-size:11px;font-weight:800;letter-spacing:.14em}
    .installers-summary{display:flex;gap:10px}
    .installers-summary>div{min-width:120px;padding:15px 17px;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:rgba(255,255,255,.045)}
    .installers-summary strong,.installers-summary span{display:block}.installers-summary strong{font-size:22px}.installers-summary span{margin-top:2px;color:#bfc5c9;font-size:12px}
    .installers-directory{overflow:hidden;padding:0}
    .installer-filter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding:24px;background:#fff;border-bottom:1px solid var(--line)}
    .installer-filter-grid .field>span{font-size:13.5px;font-weight:760;color:#3f464d}
    .installer-filter-grid select{min-height:48px;background:#fff;font-size:14.5px}
    .installer-filter-grid select:disabled{background:#f7f8f9;color:#8a9299;cursor:not-allowed}
    .installer-status{display:flex;align-items:center;gap:7px;min-height:50px;padding:13px 22px;border-bottom:1px solid var(--line);background:#fff;color:#626b73;font-size:14px;line-height:1.45}
    .installer-status strong{color:#202428}.installer-status .status-dot{width:7px;height:7px;border-radius:50%;background:#76552f;box-shadow:0 0 0 4px rgba(118,85,47,.08)}
    .installer-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:22px;background:#fff}
    .installer-card{padding:18px;border:1px solid #dfe3e6;border-radius:10px;background:#fff;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}
    .installer-card:hover{transform:translateY(-1px);border-color:#c9cfd4;box-shadow:0 8px 22px rgba(17,20,24,.055)}
    .installer-card.is-on-hold{border-color:#ddcfc0;background:#fff}
    .installer-card-top{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px}
    .installer-mark{width:40px;height:40px;border-radius:9px;display:grid;place-items:center;background:#111418;color:#fff}
    .installer-card h2{margin:0;color:#16191c;font-size:16px;letter-spacing:-.015em}.installer-card p{margin:3px 0 0;color:#68717a;font-size:13.5px}
    .installer-availability{display:inline-flex;align-items:center;justify-content:center;min-height:27px;padding:5px 8px;border:1px solid #d7e1da;border-radius:6px;background:#f7faf8;color:#365b43;font-size:10.5px;font-weight:800;letter-spacing:.055em}
    .installer-availability.hold{border-color:#e1d2c0;background:#fbf8f4;color:#805d35}
    .installer-note{margin-top:13px;padding-top:12px;border-top:1px solid #edf0f2;color:#59626a;font-size:13.5px}
    .installer-empty{grid-column:1/-1;padding:26px;text-align:center;color:#69727a;border:1px dashed #d6dce0;border-radius:10px}
    @media(max-width:900px){.installers-hero{grid-template-columns:1fr;align-items:start}.installers-summary{justify-content:flex-start}.installer-filter-grid{grid-template-columns:1fr}.installer-results{grid-template-columns:1fr}}
    @media(max-width:560px){.installers-hero{padding:23px 20px;border-radius:12px}.installers-summary{display:grid;grid-template-columns:1fr 1fr;width:100%}.installers-summary>div{min-width:0}.installer-filter-grid{padding:18px}.installer-results{padding:16px}.installer-card-top{grid-template-columns:auto minmax(0,1fr)}.installer-availability{grid-column:2;justify-self:start}.installer-status{align-items:flex-start;flex-wrap:wrap;padding:13px 16px}}
  </style>
</BaseLayout>
