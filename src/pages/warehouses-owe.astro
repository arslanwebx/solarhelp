---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATE_NAME_BY_CODE } from '../data/states';
import { WAREHOUSE_BRANCHES } from '../data/warehouses';

const statesJson = JSON.stringify(STATE_NAME_BY_CODE);
const branchesJson = JSON.stringify(WAREHOUSE_BRANCHES);
const branchStates = Array.from(
  new Map(WAREHOUSE_BRANCHES.map((branch) => [branch.stateCode, { code: branch.stateCode, name: branch.state }])).values()
).sort((a, b) => a.name.localeCompare(b.name));
const branchCount = WAREHOUSE_BRANCHES.length;
const stateCount = branchStates.length;
const largestRadius = Math.max(...WAREHOUSE_BRANCHES.map((branch) => Number.parseInt(branch.coverageRadius, 10) || 0));
---
<BaseLayout title="OWE Warehouses - SolarHelp" description="Our World Energy branch locations with source-matched coverage radius data.">
  <main class="page-shell warehouse-page">
    <section class="warehouse-hero" aria-labelledby="warehouse-title">
      <div class="warehouse-hero-copy">
        <span class="eyebrow">OUR WORLD ENERGY DIRECTORY</span>
        <h1 id="warehouse-title">OWE Branch Locations</h1>
        <p>Choose a state to view its listed OWE warehouse locations and open customer-to-warehouse driving directions in Google Maps.</p>
      </div>

      <div class="warehouse-stats" aria-label="OWE branch directory summary">
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 9.5 12 4l8.5 5.5V20H3.5z"></path><path d="M8 20v-6h8v6"></path></svg>
          </span>
          <div><strong>{branchCount}</strong><span>branch records</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3.5 12h17M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"></path></svg>
          </span>
          <div><strong>{stateCount}</strong><span>states & territories</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><circle cx="12" cy="12" r="7"></circle><path d="M12 1.8v2.1M12 20.1v2.1M1.8 12h2.1M20.1 12h2.1"></path></svg>
          </span>
          <div><strong>{largestRadius} mi</strong><span>largest listed radius</span></div>
        </div>
      </div>
    </section>

    <section class="panel directory-panel warehouse-directory" aria-label="OWE branch directory">
      <div class="warehouse-toolbar">
        <div class="toolbar-copy">
          <span class="toolbar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
          </span>
          <div><strong>Filter locations</strong><span>Choose a state to view its warehouse locations.</span></div>
        </div>

        <label class="field premium-select" for="branch-state-select">
          <span>State / territory</span>
          <select id="branch-state-select" aria-describedby="branch-status">
            <option value="" selected>Select a state / territory</option>
            {branchStates.map((state) => <option value={state.code}>{state.name} ({state.code})</option>)}
          </select>
        </label>
      </div>

      <div class="route-tool">
        <div class="route-tool-heading">
          <span class="route-tool-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="18" r="2"></circle><circle cx="18" cy="6" r="2"></circle><path d="M8 18h3a3 3 0 0 0 3-3V9a3 3 0 0 1 3-3h-1"></path></svg>
          </span>
          <div><strong>Customer address</strong><span>Enter the install address to turn every warehouse address into a driving-directions link.</span></div>
        </div>
        <div class="route-input-wrap">
          <input id="customer-address" type="text" autocomplete="street-address" placeholder="e.g. 57 Fossil Ridge Ct, Wilmington, IL 60481" aria-label="Customer installation address" />
          <button id="clear-customer-address" class="route-clear" type="button" aria-label="Clear customer address">Clear</button>
        </div>
      </div>

      <div id="branch-status" class="directory-status premium-status" aria-live="polite"></div>

      <div id="branch-table-wrap" class="table-scroll warehouse-table-wrap" hidden>
        <table class="data-table branch-table luxury-table">
          <thead><tr><th>Branch</th><th>Address</th><th>Coverage radius</th><th>Team type</th></tr></thead>
          <tbody id="branch-table-body"></tbody>
        </table>
      </div>

      <div class="source-note luxury-note">
        <span class="note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 10v6M12 7.2h.01"></path></svg>
        </span>
        <div><strong>Source notes:</strong> The source lists the Wallingford branch with a Hudson, Massachusetts address and groups the Mansfield, MA location under Rhode Island coverage. Connecticut and Vermont are listed as active coverage states, but no branch address rows are shown for them.</div>
      </div>
    </section>
  </main>

  <script id="warehouse-state-data" type="application/json" is:inline set:html={statesJson}></script>
  <script id="warehouse-branch-data" type="application/json" is:inline set:html={branchesJson}></script>
  <script>
    const stateSelect = document.getElementById('branch-state-select');
    const customerAddressInput = document.getElementById('customer-address');
    const clearCustomerAddress = document.getElementById('clear-customer-address');
    const status = document.getElementById('branch-status');
    const tableWrap = document.getElementById('branch-table-wrap');
    const tableBody = document.getElementById('branch-table-body');
    const stateNames = JSON.parse(document.getElementById('warehouse-state-data')?.textContent || '{}');
    const branches = JSON.parse(document.getElementById('warehouse-branch-data')?.textContent || '[]');

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));

    function cleanAddress(address) {
      return String(address).replace(/\s*\(ZIP not listed\)\s*/i, '').replace(/,\s*USA\s*$/i, '').trim();
    }

    function mapsUrl(destination) {
      const warehouseAddress = cleanAddress(destination);
      const customerAddress = customerAddressInput?.value.trim() || '';
      if (customerAddress) {
        return `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(customerAddress)}&destination=${encodeURIComponent(warehouseAddress)}&travelmode=driving`;
      }
      return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(warehouseAddress)}`;
    }

    function render() {
      if (!stateSelect || !status || !tableBody || !tableWrap) return;
      const code = stateSelect.value;

      if (!code) {
        status.innerHTML = '<span class="status-dot" aria-hidden="true"></span><strong>Select a state / territory</strong><span>Warehouse addresses will appear after you make a selection.</span>';
        tableBody.innerHTML = '';
        tableWrap.hidden = true;
        return;
      }

      const rows = branches.filter((branch) => branch.stateCode === code);
      const label = stateNames[code] || code;
      const hasCustomerAddress = Boolean(customerAddressInput?.value.trim());
      status.innerHTML = `<span class="status-dot" aria-hidden="true"></span><strong>${escapeHtml(label)}</strong><span>${rows.length} branch${rows.length === 1 ? '' : 'es'} shown${hasCustomerAddress ? ' · addresses open driving directions' : ''}</span>`;
      tableBody.innerHTML = '';
      tableWrap.hidden = false;

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td class="empty-row" colspan="4">No OWE branch address is listed for ${escapeHtml(label)} in the source.</td></tr>`;
        return;
      }

      const fragment = document.createDocumentFragment();
      rows.forEach((branch) => {
        const tr = document.createElement('tr');
        const teamClass = branch.teamType === 'In House' ? 'team-in-house' : 'team-integrated';
        tr.innerHTML = `
          <td><div class="branch-cell"><span class="state-badge">${escapeHtml(branch.stateCode)}</span><div><strong>${escapeHtml(branch.branch)}</strong><span>${escapeHtml(branch.state)}</span></div></div></td>
          <td>
            <a class="address-link premium-address" href="${mapsUrl(branch.address)}" target="_blank" rel="noopener noreferrer" aria-label="${hasCustomerAddress ? 'Driving directions from customer address to' : 'Open'} ${escapeHtml(branch.branch)} warehouse in Google Maps">
              <span class="address-pin" aria-hidden="true"></span>
              <span class="warehouse-address-text">${escapeHtml(branch.address)}</span>
              <span class="external-arrow" aria-hidden="true">↗</span>
            </a>
          </td>
          <td><span class="coverage-pill"><span class="coverage-dot" aria-hidden="true"></span>${escapeHtml(branch.coverageRadius)}</span></td>
          <td><span class="team-pill ${teamClass}">${escapeHtml(branch.teamType)}</span></td>
        `;
        fragment.appendChild(tr);
      });
      tableBody.appendChild(fragment);
    }

    stateSelect?.addEventListener('change', render);
    customerAddressInput?.addEventListener('input', render);
    clearCustomerAddress?.addEventListener('click', () => {
      if (!customerAddressInput) return;
      customerAddressInput.value = '';
      customerAddressInput.focus();
      render();
    });
    render();
  </script>

  <style>
    .route-tool{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(320px,1.25fr);align-items:center;gap:24px;padding:19px 22px;background:#fff;border-bottom:1px solid var(--line)}
    .route-tool-heading{display:flex;align-items:center;gap:12px;min-width:0}
    .route-tool-icon{flex:0 0 auto;width:38px;height:38px;border-radius:9px;display:grid;place-items:center;background:#111418;color:#fff;box-shadow:0 4px 12px rgba(17,20,24,.09)}
    .route-tool-heading>div{display:grid;gap:2px;min-width:0}.route-tool-heading strong{font-size:14px;color:#202428}.route-tool-heading span{font-size:12px;color:#68717a;line-height:1.4}
    .route-input-wrap{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;min-width:0}
    .route-input-wrap input{min-width:0;background:#fff}
    .route-clear{min-height:46px;padding:0 14px;border:1px solid #d4d9de;border-radius:8px;background:#fff;color:#4d555d;font-weight:700;cursor:pointer;transition:background .16s ease,border-color .16s ease,color .16s ease}.route-clear:hover{background:#f5f6f7;border-color:#bcc3c9;color:#111418}
    @media(max-width:820px){.route-tool{grid-template-columns:1fr;gap:14px}.route-input-wrap{grid-template-columns:minmax(0,1fr) auto}}
    @media(max-width:520px){.route-tool{padding:16px}.route-tool-heading{align-items:flex-start}.route-input-wrap{grid-template-columns:1fr}.route-clear{width:100%}}
  </style>
</BaseLayout>
