---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATE_NAME_BY_CODE } from '../data/states';
import { WAREHOUSE_BRANCHES } from '../data/warehouses';

const statesJson = JSON.stringify(STATE_NAME_BY_CODE);
const branchesJson = JSON.stringify(WAREHOUSE_BRANCHES);
const branchStates = Array.from(
  new Map(WAREHOUSE_BRANCHES.map((branch) => [branch.stateCode, { code: branch.stateCode, name: branch.state }])).values()
).sort((a, b) => a.name.localeCompare(b.name));
const branchCount = WAREHOUSE_BRANCHES.length;
const stateCount = branchStates.length;
const largestRadius = Math.max(...WAREHOUSE_BRANCHES.map((branch) => Number.parseInt(branch.coverageRadius, 10) || 0));
---
<BaseLayout title="OWE Warehouses - SolarHelp" description="Our World Energy branch locations with source-matched coverage radius data.">
  <main class="page-shell warehouse-page">
    <section class="warehouse-hero" aria-labelledby="warehouse-title">
      <div class="warehouse-hero-copy">
        <span class="eyebrow">OUR WORLD ENERGY DIRECTORY</span>
        <h1 id="warehouse-title">OWE Branch Locations</h1>
        <p>Browse every branch listed in the source, filter by state, and open any address directly in Google Maps.</p>
      </div>

      <div class="warehouse-stats" aria-label="OWE branch directory summary">
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 9.5 12 4l8.5 5.5V20H3.5z"></path><path d="M8 20v-6h8v6"></path>
            </svg>
          </span>
          <div><strong>{branchCount}</strong><span>branch records</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle><path d="M3.5 12h17M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"></path>
            </svg>
          </span>
          <div><strong>{stateCount}</strong><span>states & territories</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle><circle cx="12" cy="12" r="7"></circle><path d="M12 1.8v2.1M12 20.1v2.1M1.8 12h2.1M20.1 12h2.1"></path>
            </svg>
          </span>
          <div><strong>{largestRadius} mi</strong><span>largest listed radius</span></div>
        </div>
      </div>
    </section>

    <section class="panel directory-panel warehouse-directory" aria-label="OWE branch directory">
      <div class="warehouse-toolbar">
        <div class="toolbar-copy">
          <span class="toolbar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 6h16M7 12h10M10 18h4"></path>
            </svg>
          </span>
          <div>
            <strong>Filter locations</strong>
            <span>Choose a state to narrow the branch list.</span>
          </div>
        </div>

        <label class="field premium-select" for="branch-state-select">
          <span>State / territory</span>
          <select id="branch-state-select" aria-describedby="branch-status">
            <option value="ALL">All branch states / territories</option>
            {branchStates.map((state) => <option value={state.code}>{state.name} ({state.code})</option>)}
          </select>
        </label>
      </div>

      <div id="branch-status" class="directory-status premium-status" aria-live="polite"></div>

      <div class="table-scroll warehouse-table-wrap">
        <table class="data-table branch-table luxury-table">
          <thead>
            <tr>
              <th>Branch</th>
              <th>Address</th>
              <th>Coverage radius</th>
              <th>Team type</th>
            </tr>
          </thead>
          <tbody id="branch-table-body"></tbody>
        </table>
      </div>

      <div class="source-note luxury-note">
        <span class="note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 10v6M12 7.2h.01"></path>
          </svg>
        </span>
        <div><strong>Source notes:</strong> The source lists the Wallingford branch with a Hudson, Massachusetts address and groups the Mansfield, MA location under Rhode Island coverage. Connecticut and Vermont are listed as active coverage states, but no branch address rows are shown for them.</div>
      </div>
    </section>
  </main>

  <script id="warehouse-state-data" type="application/json" is:inline set:html={statesJson}></script>
  <script id="warehouse-branch-data" type="application/json" is:inline set:html={branchesJson}></script>
  <script>
    const stateSelect = document.getElementById('branch-state-select');
    const status = document.getElementById('branch-status');
    const tableBody = document.getElementById('branch-table-body');
    const stateNames = JSON.parse(document.getElementById('warehouse-state-data')?.textContent || '{}');
    const branches = JSON.parse(document.getElementById('warehouse-branch-data')?.textContent || '[]');

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[char]));

    function mapsUrl(address) {
      const cleaned = String(address).replace(/\s*\(ZIP not listed\)\s*/i, '').replace(/,\s*USA\s*$/i, '');
      return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(cleaned)}`;
    }

    function render() {
      if (!stateSelect || !status || !tableBody) return;
      const code = stateSelect.value;
      const rows = code === 'ALL' ? branches : branches.filter((branch) => branch.stateCode === code);
      const label = code === 'ALL' ? 'All locations' : (stateNames[code] || code);
      status.innerHTML = `<span class="status-dot" aria-hidden="true"></span><strong>${escapeHtml(label)}</strong><span>${rows.length} branch${rows.length === 1 ? '' : 'es'} shown</span>`;
      tableBody.innerHTML = '';

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td class="empty-row" colspan="4">No OWE branch address is listed for ${escapeHtml(label)} in the source.</td></tr>`;
        return;
      }

      const fragment = document.createDocumentFragment();
      rows.forEach((branch) => {
        const tr = document.createElement('tr');
        const teamClass = branch.teamType === 'In House' ? 'team-in-house' : 'team-integrated';
        tr.innerHTML = `
          <td>
            <div class="branch-cell">
              <span class="state-badge">${escapeHtml(branch.stateCode)}</span>
              <div><strong>${escapeHtml(branch.branch)}</strong><span>${escapeHtml(branch.state)}</span></div>
            </div>
          </td>
          <td>
            <a class="address-link premium-address" href="${mapsUrl(branch.address)}" target="_blank" rel="noopener noreferrer">
              <span class="address-pin" aria-hidden="true"></span>
              <span>${escapeHtml(branch.address)}</span>
              <span class="external-arrow" aria-hidden="true">↗</span>
            </a>
          </td>
          <td><span class="coverage-pill"><span class="coverage-dot" aria-hidden="true"></span>${escapeHtml(branch.coverageRadius)}</span></td>
          <td><span class="team-pill ${teamClass}">${escapeHtml(branch.teamType)}</span></td>
        `;
        fragment.appendChild(tr);
      });
      tableBody.appendChild(fragment);
    }

    stateSelect?.addEventListener('change', render);
    render();
  </script>
</BaseLayout>
