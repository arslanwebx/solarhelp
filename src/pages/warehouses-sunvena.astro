---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATE_NAME_BY_CODE } from '../data/states';
import { SUNVENA_WAREHOUSES, SUNVENA_TRIP_CHARGE_THRESHOLD_MILES } from '../data/sunvena';

const statesJson = JSON.stringify(STATE_NAME_BY_CODE);
const warehousesJson = JSON.stringify(SUNVENA_WAREHOUSES);
const warehouseStates = Array.from(
  new Map(SUNVENA_WAREHOUSES.map((warehouse) => [warehouse.stateCode, { code: warehouse.stateCode, name: warehouse.state }])).values()
).sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title="SunVena Warehouses - SolarHelp" description="SunVena warehouse locations in Florida and Georgia with the installer trip charge rule.">
  <main class="page-shell warehouse-page">
    <section class="warehouse-hero sunvena-hero" aria-labelledby="sunvena-title">
      <div class="warehouse-hero-copy">
        <span class="eyebrow">SUNVENA WAREHOUSE DIRECTORY</span>
        <h1 id="sunvena-title">SunVena Warehouses</h1>
        <p>Browse the SunVena warehouse locations in Florida and Georgia and open each address directly in Google Maps.</p>
      </div>

      <div class="warehouse-stats" aria-label="SunVena warehouse summary">
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 9.5 12 4l8.5 5.5V20H3.5z"></path><path d="M8 20v-6h8v6"></path>
            </svg>
          </span>
          <div><strong>{SUNVENA_WAREHOUSES.length}</strong><span>warehouse locations</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle><path d="M3.5 12h17M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"></path>
            </svg>
          </span>
          <div><strong>{warehouseStates.length}</strong><span>states covered</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 17h16M6 17l2-7h8l2 7M9.5 10V7.5h5V10"></path><circle cx="8" cy="19" r="1.5"></circle><circle cx="16" cy="19" r="1.5"></circle>
            </svg>
          </span>
          <div><strong>&gt; {SUNVENA_TRIP_CHARGE_THRESHOLD_MILES} mi</strong><span>trip charge required</span></div>
        </div>
      </div>
    </section>

    <section class="trip-charge-banner" aria-label="SunVena trip charge rule">
      <span class="trip-charge-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 16V9.5h11.5l3 3V16"></path><path d="M7 9.5 9 6h5l1.5 3.5"></path><circle cx="7" cy="17.5" r="2"></circle><circle cx="17" cy="17.5" r="2"></circle>
        </svg>
      </span>
      <div class="trip-charge-copy">
        <strong>100-mile trip charge rule</strong>
        <span>If the installation address is more than {SUNVENA_TRIP_CHARGE_THRESHOLD_MILES} miles from the applicable SunVena warehouse, a trip charge is required by the installer.</span>
      </div>
      <span class="trip-charge-threshold">&gt; {SUNVENA_TRIP_CHARGE_THRESHOLD_MILES} mi</span>
    </section>

    <section class="panel directory-panel warehouse-directory sunvena-directory" aria-label="SunVena warehouse directory">
      <div class="warehouse-toolbar">
        <div class="toolbar-copy">
          <span class="toolbar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 6h16M7 12h10M10 18h4"></path>
            </svg>
          </span>
          <div>
            <strong>Filter warehouses</strong>
            <span>Choose Florida or Georgia to narrow the list.</span>
          </div>
        </div>

        <label class="field premium-select" for="sunvena-state-select">
          <span>State</span>
          <select id="sunvena-state-select" aria-describedby="sunvena-status">
            <option value="ALL">All SunVena warehouse states</option>
            {warehouseStates.map((state) => <option value={state.code}>{state.name} ({state.code})</option>)}
          </select>
        </label>
      </div>

      <div id="sunvena-status" class="directory-status premium-status" aria-live="polite"></div>

      <div class="table-scroll warehouse-table-wrap">
        <table class="data-table luxury-table sunvena-table">
          <thead>
            <tr>
              <th>Warehouse</th>
              <th>Address</th>
              <th>State</th>
            </tr>
          </thead>
          <tbody id="sunvena-table-body"></tbody>
        </table>
      </div>

      <div class="source-note luxury-note">
        <span class="note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 10v6M12 7.2h.01"></path>
          </svg>
        </span>
        <div><strong>Installer rule:</strong> The 100-mile threshold applies from the applicable SunVena warehouse to the installation address. Distances above that threshold require a trip charge.</div>
      </div>
    </section>
  </main>

  <script id="sunvena-state-data" type="application/json" is:inline set:html={statesJson}></script>
  <script id="sunvena-warehouse-data" type="application/json" is:inline set:html={warehousesJson}></script>
  <script>
    const stateSelect = document.getElementById('sunvena-state-select');
    const status = document.getElementById('sunvena-status');
    const tableBody = document.getElementById('sunvena-table-body');
    const stateNames = JSON.parse(document.getElementById('sunvena-state-data')?.textContent || '{}');
    const warehouses = JSON.parse(document.getElementById('sunvena-warehouse-data')?.textContent || '[]');

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[char]));

    function mapsUrl(address) {
      return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(String(address))}`;
    }

    function render() {
      if (!stateSelect || !status || !tableBody) return;
      const code = stateSelect.value;
      const rows = code === 'ALL' ? warehouses : warehouses.filter((warehouse) => warehouse.stateCode === code);
      const label = code === 'ALL' ? 'All SunVena locations' : (stateNames[code] || code);
      status.innerHTML = `<span class="status-dot" aria-hidden="true"></span><strong>${escapeHtml(label)}</strong><span>${rows.length} warehouse${rows.length === 1 ? '' : 's'} shown</span>`;
      tableBody.innerHTML = '';

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td class="empty-row" colspan="3">No SunVena warehouse is listed for ${escapeHtml(label)}.</td></tr>`;
        return;
      }

      const fragment = document.createDocumentFragment();
      rows.forEach((warehouse) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <div class="branch-cell">
              <span class="state-badge">${escapeHtml(warehouse.stateCode)}</span>
              <div><strong>${escapeHtml(warehouse.branch)}</strong><span>SunVena warehouse</span></div>
            </div>
          </td>
          <td>
            <a class="address-link premium-address" href="${mapsUrl(warehouse.address)}" target="_blank" rel="noopener noreferrer">
              <span class="address-pin" aria-hidden="true"></span>
              <span>${escapeHtml(warehouse.address)}</span>
              <span class="external-arrow" aria-hidden="true">↗</span>
            </a>
          </td>
          <td><span class="team-pill team-integrated">${escapeHtml(warehouse.state)}</span></td>
        `;
        fragment.appendChild(tr);
      });
      tableBody.appendChild(fragment);
    }

    stateSelect?.addEventListener('change', render);
    render();
  </script>

  <style>
    .sunvena-hero::before {
      content: '';
      position: absolute;
      left: 42%;
      bottom: -140px;
      width: 360px;
      height: 260px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(213,178,116,.11) 0%, rgba(213,178,116,0) 68%);
      pointer-events: none;
    }
    .trip-charge-banner {
      display: grid;
      grid-template-columns: auto minmax(0,1fr) auto;
      align-items: center;
      gap: 15px;
      margin: 0 0 22px;
      padding: 17px 18px;
      border: 1px solid #e2d2b7;
      border-radius: 16px;
      background: linear-gradient(110deg,#fffaf1 0%,#f7efdf 100%);
      box-shadow: 0 8px 24px rgba(70,53,29,.07);
    }
    .trip-charge-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      color: #7b5d30;
      background: #fff;
      border: 1px solid #e6d7bd;
      box-shadow: 0 5px 14px rgba(82,61,30,.08);
    }
    .trip-charge-copy {
      display: grid;
      gap: 3px;
      min-width: 0;
    }
    .trip-charge-copy strong {
      color: #2d2922;
      font-size: 14px;
      letter-spacing: -.01em;
    }
    .trip-charge-copy span {
      color: #716654;
      font-size: 13px;
      line-height: 1.5;
    }
    .trip-charge-threshold {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 84px;
      min-height: 38px;
      padding: 7px 11px;
      border-radius: 999px;
      background: #1b2024;
      color: #e0bd80;
      font-weight: 800;
      font-size: 12px;
      letter-spacing: .025em;
      white-space: nowrap;
    }
    .sunvena-table {
      min-width: 680px;
    }
    @media (max-width: 700px) {
      .trip-charge-banner {
        grid-template-columns: auto minmax(0,1fr);
        align-items: start;
      }
      .trip-charge-threshold {
        grid-column: 2;
        justify-self: start;
        margin-top: 4px;
      }
    }
  </style>
</BaseLayout>
