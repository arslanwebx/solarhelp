---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATE_NAME_BY_CODE } from '../data/states';
import { SUNVENA_WAREHOUSES, SUNVENA_TRIP_CHARGE_THRESHOLD_MILES } from '../data/sunvena';

const statesJson = JSON.stringify(STATE_NAME_BY_CODE);
const warehousesJson = JSON.stringify(SUNVENA_WAREHOUSES);
const warehouseStates = Array.from(
  new Map(SUNVENA_WAREHOUSES.map((warehouse) => [warehouse.stateCode, { code: warehouse.stateCode, name: warehouse.state }])).values()
).sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title="SunVena Warehouses - SolarHelp" description="SunVena warehouse locations in Florida and Georgia with the installer trip charge rule.">
  <main class="page-shell warehouse-page">
    <section class="warehouse-hero sunvena-hero" aria-labelledby="sunvena-title">
      <div class="warehouse-hero-copy">
        <span class="eyebrow">SUNVENA WAREHOUSE DIRECTORY</span>
        <h1 id="sunvena-title">SunVena Warehouses</h1>
        <p>Choose a state to view its listed SunVena warehouse locations and open customer-to-warehouse driving directions in Google Maps.</p>
      </div>

      <div class="warehouse-stats" aria-label="SunVena warehouse summary">
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 9.5 12 4l8.5 5.5V20H3.5z"></path><path d="M8 20v-6h8v6"></path></svg>
          </span>
          <div><strong>{SUNVENA_WAREHOUSES.length}</strong><span>warehouse locations</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3.5 12h17M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"></path></svg>
          </span>
          <div><strong>{warehouseStates.length}</strong><span>states covered</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17h16M6 17l2-7h8l2 7M9.5 10V7.5h5V10"></path><circle cx="8" cy="19" r="1.5"></circle><circle cx="16" cy="19" r="1.5"></circle></svg>
          </span>
          <div><strong>&gt; {SUNVENA_TRIP_CHARGE_THRESHOLD_MILES} mi</strong><span>trip charge required</span></div>
        </div>
      </div>
    </section>

    <section class="trip-charge-banner" aria-label="SunVena trip charge rule">
      <span class="trip-charge-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16V9.5h11.5l3 3V16"></path><path d="M7 9.5 9 6h5l1.5 3.5"></path><circle cx="7" cy="17.5" r="2"></circle><circle cx="17" cy="17.5" r="2"></circle></svg>
      </span>
      <div class="trip-charge-copy">
        <strong>100-mile trip charge rule</strong>
        <span>If the installation address is more than {SUNVENA_TRIP_CHARGE_THRESHOLD_MILES} miles from the applicable SunVena warehouse, a trip charge is required by the installer.</span>
      </div>
      <span class="trip-charge-threshold">&gt; {SUNVENA_TRIP_CHARGE_THRESHOLD_MILES} mi</span>
    </section>

    <section class="panel directory-panel warehouse-directory sunvena-directory" aria-label="SunVena warehouse directory">
      <div class="warehouse-toolbar sunvena-toolbar">
        <label class="field premium-select sunvena-state-select" for="sunvena-state-select">
          <span>State</span>
          <select id="sunvena-state-select" aria-describedby="sunvena-status">
            <option value="" selected>Select a state</option>
            {warehouseStates.map((state) => <option value={state.code}>{state.name} ({state.code})</option>)}
          </select>
        </label>

        <div class="toolbar-copy sunvena-toolbar-copy">
          <span class="toolbar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
          </span>
          <div><strong>Filter warehouses</strong><span>Choose Florida or Georgia to view warehouse addresses.</span></div>
        </div>
      </div>

      <div class="route-tool">
        <div class="route-tool-heading">
          <span class="route-tool-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="18" r="2"></circle><circle cx="18" cy="6" r="2"></circle><path d="M8 18h3a3 3 0 0 0 3-3V9a3 3 0 0 1 3-3h-1"></path></svg>
          </span>
          <div><strong>Customer address</strong><span>Enter the install address. Each warehouse address will open driving directions so you can check the 100-mile rule.</span></div>
        </div>
        <div class="route-input-wrap">
          <input id="sunvena-customer-address" type="text" autocomplete="street-address" placeholder="e.g. 123 Main St, Tampa, FL 33619" aria-label="Customer installation address" />
          <button id="clear-sunvena-customer-address" class="route-clear" type="button" aria-label="Clear customer address">Clear</button>
        </div>
      </div>

      <div id="sunvena-status" class="directory-status premium-status" aria-live="polite"></div>

      <div id="sunvena-table-wrap" class="table-scroll warehouse-table-wrap" hidden>
        <table class="data-table luxury-table sunvena-table">
          <thead><tr><th>Warehouse</th><th>Address</th><th>State</th></tr></thead>
          <tbody id="sunvena-table-body"></tbody>
        </table>
      </div>

      <div class="source-note luxury-note">
        <span class="note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 10v6M12 7.2h.01"></path></svg>
        </span>
        <div><strong>Installer rule:</strong> The 100-mile threshold applies from the applicable SunVena warehouse to the installation address. Open the driving-direction link to verify the route distance; distances above that threshold require a trip charge.</div>
      </div>
    </section>
  </main>

  <script id="sunvena-state-data" type="application/json" is:inline set:html={statesJson}></script>
  <script id="sunvena-warehouse-data" type="application/json" is:inline set:html={warehousesJson}></script>
  <script>
    const stateSelect = document.getElementById('sunvena-state-select');
    const customerAddressInput = document.getElementById('sunvena-customer-address');
    const clearCustomerAddress = document.getElementById('clear-sunvena-customer-address');
    const status = document.getElementById('sunvena-status');
    const tableWrap = document.getElementById('sunvena-table-wrap');
    const tableBody = document.getElementById('sunvena-table-body');
    const stateNames = JSON.parse(document.getElementById('sunvena-state-data')?.textContent || '{}');
    const warehouses = JSON.parse(document.getElementById('sunvena-warehouse-data')?.textContent || '[]');

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));

    function mapsUrl(destination) {
      const warehouseAddress = String(destination).trim();
      const customerAddress = customerAddressInput?.value.trim() || '';
      if (customerAddress) {
        return `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(customerAddress)}&destination=${encodeURIComponent(warehouseAddress)}&travelmode=driving`;
      }
      return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(warehouseAddress)}`;
    }

    function render() {
      if (!stateSelect || !status || !tableBody || !tableWrap) return;
      const code = stateSelect.value;

      if (!code) {
        status.innerHTML = '<span class="status-dot" aria-hidden="true"></span><strong>Select a state</strong><span>Warehouse addresses will appear after you make a selection.</span>';
        tableBody.innerHTML = '';
        tableWrap.hidden = true;
        return;
      }

      const rows = warehouses.filter((warehouse) => warehouse.stateCode === code);
      const label = stateNames[code] || code;
      const hasCustomerAddress = Boolean(customerAddressInput?.value.trim());
      const distanceHint = hasCustomerAddress ? ' · <strong class="distance-hint">Click on the addresses below to see the distance.</strong>' : '';
      status.innerHTML = `<span class="status-dot" aria-hidden="true"></span><strong>${escapeHtml(label)}</strong><span>${rows.length} warehouse${rows.length === 1 ? '' : 's'} shown${distanceHint}</span>`;
      tableBody.innerHTML = '';
      tableWrap.hidden = false;

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td class="empty-row" colspan="3">No SunVena warehouse is listed for ${escapeHtml(label)}.</td></tr>`;
        return;
      }

      const fragment = document.createDocumentFragment();
      rows.forEach((warehouse) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><div class="branch-cell"><span class="state-badge">${escapeHtml(warehouse.stateCode)}</span><div><strong>${escapeHtml(warehouse.branch)}</strong><span>SunVena warehouse</span></div></div></td>
          <td>
            <a class="address-link premium-address" href="${mapsUrl(warehouse.address)}" target="_blank" rel="noopener noreferrer" aria-label="${hasCustomerAddress ? 'Driving directions from customer address to' : 'Open'} ${escapeHtml(warehouse.branch)} SunVena warehouse in Google Maps">
              <span class="address-pin" aria-hidden="true"></span>
              <span class="warehouse-address-text">${escapeHtml(warehouse.address)}</span>
              <span class="external-arrow" aria-hidden="true">↗</span>
            </a>
          </td>
          <td><span class="team-pill team-integrated">${escapeHtml(warehouse.state)}</span></td>
        `;
        fragment.appendChild(tr);
      });
      tableBody.appendChild(fragment);
    }

    stateSelect?.addEventListener('change', render);
    customerAddressInput?.addEventListener('input', render);
    clearCustomerAddress?.addEventListener('click', () => {
      if (!customerAddressInput) return;
      customerAddressInput.value = '';
      customerAddressInput.focus();
      render();
    });
    render();
  </script>

  <style>
    .trip-charge-banner{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:15px;margin:0 0 22px;padding:16px 18px;border:1px solid #dfe3e6;border-left:3px solid #76552f;border-radius:10px;background:#fff;box-shadow:var(--shadow-soft)}
    .trip-charge-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:9px;color:#fff;background:#111418;border:1px solid #111418}
    .trip-charge-copy{display:grid;gap:3px;min-width:0}.trip-charge-copy strong{color:#202428;font-size:15px;letter-spacing:-.01em}.trip-charge-copy span{color:#5f6871;font-size:14px;line-height:1.5}
    .trip-charge-threshold{display:inline-flex;align-items:center;justify-content:center;min-width:84px;min-height:38px;padding:7px 11px;border-radius:7px;background:#111418;color:#fff;font-weight:800;font-size:13px;letter-spacing:.025em;white-space:nowrap}
    .sunvena-table{min-width:680px}
    .sunvena-toolbar{display:grid;grid-template-columns:minmax(260px,340px) minmax(0,1fr);align-items:end;justify-content:stretch;gap:24px}
    .sunvena-state-select{grid-column:1;width:100%}
    .sunvena-toolbar-copy{grid-column:2;justify-self:start;padding-bottom:2px}
    .sunvena-toolbar .toolbar-copy span{font-size:14px;line-height:1.45}
    .sunvena-toolbar .toolbar-copy strong{font-size:15px}
    .sunvena-state-select>span{font-size:13.5px;font-weight:760;color:#3f464d}
    .route-tool{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(320px,1.25fr);align-items:center;gap:24px;padding:19px 22px;background:#fff;border-bottom:1px solid var(--line)}
    .route-tool-heading{display:flex;align-items:center;gap:12px;min-width:0}
    .route-tool-icon{flex:0 0 auto;width:38px;height:38px;border-radius:9px;display:grid;place-items:center;background:#111418;color:#fff;box-shadow:0 4px 12px rgba(17,20,24,.09)}
    .route-tool-heading>div{display:grid;gap:3px;min-width:0}.route-tool-heading strong{font-size:15px;color:#202428}.route-tool-heading span{font-size:14px;color:#5f6871;line-height:1.45}
    .route-input-wrap{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;min-width:0}
    .route-input-wrap input{min-width:0;background:#fff;font-size:15px}
    .route-clear{min-height:46px;padding:0 14px;border:1px solid #d4d9de;border-radius:8px;background:#fff;color:#4d555d;font-weight:700;cursor:pointer;transition:background .16s ease,border-color .16s ease,color .16s ease}.route-clear:hover{background:#f5f6f7;border-color:#bcc3c9;color:#111418}
    .premium-status{font-size:14.5px;line-height:1.45}
    .distance-hint{font-weight:800;color:#202428}
    .source-note{font-size:14px;line-height:1.55}
    @media(max-width:820px){.sunvena-toolbar{grid-template-columns:1fr;gap:14px;align-items:stretch}.sunvena-state-select,.sunvena-toolbar-copy{grid-column:1}.sunvena-state-select{max-width:none}.sunvena-toolbar-copy{justify-self:stretch}.route-tool{grid-template-columns:1fr;gap:14px}.route-input-wrap{grid-template-columns:minmax(0,1fr) auto}}
    @media(max-width:700px){.trip-charge-banner{grid-template-columns:auto minmax(0,1fr);align-items:start}.trip-charge-threshold{grid-column:2;justify-self:start;margin-top:4px}}
    @media(max-width:520px){.trip-charge-banner{padding:14px}.route-tool{padding:16px}.route-tool-heading{align-items:flex-start}.route-input-wrap{grid-template-columns:1fr}.route-clear{width:100%}}
  </style>
</BaseLayout>
